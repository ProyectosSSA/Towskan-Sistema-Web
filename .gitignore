# ==============================================================
# .gitignore oficial para Towskan (Full-Stack Next.js + Flask)
# ==============================================================

# Node.js & Next.js
**/node_modules/
node_modules/
**/.next/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python & Entornos Virtuales
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
**/venv/
venv/
**/env/
env/
.pytest_cache/
.coverage

# Bases de datos locales SQLite
*.db
*.sqlite
*.sqlite3

# Variables de entorno y secretos
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!.env.example
!.env.local.example

# IDEs y Editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs y Temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
