# Configuración del Servidor Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Seguridad y Autenticación JWT
SECRET_KEY=towskan_super_secret_jwt_key_production_grade_2026_xyz
JWT_EXPIRATION_HOURS=24

# Base de Datos (SQLite por defecto para desarrollo local)
# Para migrar a MySQL: mysql+pymysql://usuario:password@localhost:3306/towskan_db
DATABASE_URL=sqlite:///towskan.db

# Configuración CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
